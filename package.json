{
  "name": "dspace-cloudflare-serverless",
  "version": "1.0.0",
  "description": "Serverless DSpace Ebook Uploader powered by Cloudflare Workers, Pages, and D1 Database",
  "main": "src/index.js",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "d1:create": "wrangler d1 create dspace-db",
    "d1:init:local": "wrangler d1 execute dspace-db --local --file=schema.sql",
    "d1:init:remote": "wrangler d1 execute dspace-db --remote --file=schema.sql"
  },
  "keywords": [
    "cloudflare",
    "cloudflare-workers",
    "d1",
    "dspace",
    "serverless"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "wrangler": "^3.114.0"
  }
}
